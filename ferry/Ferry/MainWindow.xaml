<Window x:Class="Islands.Ferry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Islands.Ferry"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Island" Width="1280" Height="840" MinWidth="760" MinHeight="480"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <DataTemplate DataType="{x:Type local:PersonMsg}">
      <Border Background="{StaticResource UserBubble}" CornerRadius="10" Padding="14,10" Margin="120,6,16,6" HorizontalAlignment="Right">
        <StackPanel>
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding By}" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:HerMsg}">
      <StackPanel Margin="16,6,80,6">
        <Expander Header="her thinking" Foreground="{StaticResource Dim}" FontSize="12" Visibility="{Binding HasReasoning, Converter={StaticResource Vis}}" Margin="0,0,0,4">
          <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="13" Margin="16,4,0,4"/>
        </Expander>
        <local:MarkdownBox Markdown="{Binding Text}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" Visibility="{Binding HasText, Converter={StaticResource Vis}}"/>
        <TextBlock Text="{Binding Model}" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding HasText, Converter={StaticResource Vis}}"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ToolMsg}">
      <Expander Margin="16,1,80,1" Foreground="{StaticResource Dim}" FontSize="12">
        <Expander.Header><TextBlock Text="{Binding Line}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/></Expander.Header>
        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="16,4,0,4"/>
      </Expander>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:NoteMsg}">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="16,4,80,4"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:LiveMsg}">
      <StackPanel Margin="16,6,80,6">
        <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="13" Visibility="{Binding HasReasoning, Converter={StaticResource Vis}}" MaxHeight="160" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- top: the island, and how the ferry is doing -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="IslandName" Text="Island" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="Model" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <!-- the Now bar: her mode and tone, from the mode shrine, as her turns see it -->
        <Border x:Name="Shrine" Visibility="Collapsed" Margin="14,0,14,0" Padding="10,2" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Left"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run x:Name="ShrineEmoji" FontFamily="Segoe UI Emoji"/><Run Text=" "/><Run x:Name="ShrineMode" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><Run x:Name="ShrineTone" Foreground="{StaticResource Dim}"/>
          </TextBlock>
        </Border>
        <TextBlock x:Name="Mode" Foreground="{StaticResource Dim}" Margin="14,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- a notice from her (the notify tool) -->
    <Border Grid.Row="1" x:Name="NoticeBar" Visibility="Collapsed" Background="#2A2410" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1" Padding="16,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Got it" Click="DismissNotice" Padding="10,3"/>
        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Warn}"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- chats and threads -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,10,0">
            <Button DockPanel.Dock="Right" Content="New" Click="NewChat" Padding="10,3" Margin="0,8,0,0"/>
            <TextBlock Text="CHATS" Style="{StaticResource Head}"/>
          </DockPanel>
          <ListBox Grid.Row="1" x:Name="Chats" SelectionChanged="ChatPicked" Margin="4,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="6,6">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding When}" Foreground="{StaticResource Dim}" FontSize="11"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="THREADS" Style="{StaticResource Head}"/>
          <ListBox Grid.Row="3" x:Name="Threads" MaxHeight="220" Margin="4,0,4,8" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="6,4">
                  <Button DockPanel.Dock="Right" Content="Stop" Tag="{Binding Id}" Click="StopThread" Padding="8,2" Visibility="{Binding Running, Converter={StaticResource Vis}}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                    <TextBlock Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding Status, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Progress, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <TabControl Grid.Column="1" x:Name="Tabs" Background="{StaticResource Bg}" BorderThickness="0" Padding="0">
        <TabItem Header="Chat">
          <Grid Background="{StaticResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="MsgScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="Messages" Margin="0,10"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyChat" Grid.Row="0" Text="Pick a chat, or start a new one." Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                  <Button x:Name="StopBtn" Content="Stop" Click="StopTurn" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{StaticResource Bad}"/>
                  <Button x:Name="SendBtn" Content="Send" Style="{StaticResource Solid}" Click="Send"/>
                </StackPanel>
                <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="200" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputKey" ToolTip="Ctrl+Enter sends"/>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Vault">
          <Grid Background="{StaticResource Bg}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
              <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshVault" Padding="10,3"/>
                <TextBlock Text="HER VAULT" Style="{StaticResource Head}" Margin="2,4,0,0"/>
              </DockPanel>
              <TreeView x:Name="VaultTree" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" SelectedItemChanged="VaultPicked">
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Margin="2,2"><Run Text="{Binding Icon, Mode=OneWay}" Foreground="{StaticResource Dim}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Ink}"/></TextBlock>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,1" Padding="12,8">
                <DockPanel>
                  <Button x:Name="SaveBtn" DockPanel.Dock="Right" Content="Save" Style="{StaticResource Solid}" Click="SaveFile" IsEnabled="False"/>
                  <TextBlock x:Name="FilePath" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                </DockPanel>
              </Border>
              <ae:TextEditor x:Name="Editor" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Cascadia Mono, Consolas" FontSize="14" ShowLineNumbers="True" WordWrap="True" Padding="10" LineNumbersForeground="#5A516B"/>
            </DockPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Heartbeat">
          <ScrollViewer Background="{StaticResource Bg}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,20" MaxWidth="820" HorizontalAlignment="Left">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="HbStopBtn" Content="Stop this beat" Click="HbStop" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{StaticResource Bad}"/>
                  <Button x:Name="HbNowBtn" Content="Beat now" Click="HbBeatNow" Margin="0,0,8,0" ToolTip="One beat now, whether it's paused or not"/>
                  <Button x:Name="HbToggleBtn" Content="Pause" Style="{StaticResource Solid}" Click="HbToggle"/>
                </StackPanel>
                <TextBlock Text="HEARTBEAT" Style="{StaticResource Head}" Margin="0,0,16,0" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock x:Name="HbState" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,12" TextWrapping="Wrap" Text="…"/>
              <Grid x:Name="HbFacts" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Beats" Foreground="{StaticResource Dim}" Margin="0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HbEvery" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Model" Foreground="{StaticResource Dim}" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HbModel" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Last beat" Foreground="{StaticResource Dim}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HbLast" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="How it went" Foreground="{StaticResource Dim}" Margin="0,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HbHow" Margin="0,3" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Text="Next beat" Foreground="{StaticResource Dim}" Margin="0,3"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HbNext" Margin="0,3"/>
              </Grid>
              <DockPanel x:Name="HbResultHead" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Open its chat" Click="HbOpenChat" Padding="10,3"/>
                <TextBlock Style="{StaticResource Head}" Margin="0,4,0,0"><Run Text="WHAT IT CAME TO"/><Run x:Name="HbResultMeta" Foreground="{StaticResource Dim}" FontWeight="Normal"/></TextBlock>
              </DockPanel>
              <Border x:Name="HbResultBox" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                <local:MarkdownBox x:Name="HbResult" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Keys">
          <StackPanel Background="{StaticResource Bg}" Margin="20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,0,0,12">Her keys are sealed to the island's own account. A key goes in here once and never comes back out: not to this window, a chat, the log, or a tool. Tools and settings name it as {{NAME}}.</TextBlock>
            <ListBox x:Name="KeyList" Margin="0,0,0,12"/>
            <TextBlock Text="NAME" Style="{StaticResource Head}" Margin="0,4,0,4"/>
            <TextBox x:Name="KeyName"/>
            <TextBlock Text="VALUE" Style="{StaticResource Head}" Margin="0,10,0,4"/>
            <PasswordBox x:Name="KeyValue"/>
            <Button Content="Put it in" Style="{StaticResource Solid}" Click="SetKey" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <TextBlock x:Name="Status" Foreground="{StaticResource Dim}" FontSize="12" Text="Connecting…"/>
    </Border>
  </Grid>
</Window>
